# Copie para .env e NUNCA faça commit de chaves reais.
# O curso funciona sem nenhuma chave; as integrações são opcionais.

# --- Provedor OpenAI ou compatível (vLLM, LM Studio, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Ollama local ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=curso_rag

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql://curso:curso@localhost:5432/curso_rag

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=curso-rag-local

# --- Aplicação ---
APP_ENV=local
LOG_LEVEL=INFO
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
